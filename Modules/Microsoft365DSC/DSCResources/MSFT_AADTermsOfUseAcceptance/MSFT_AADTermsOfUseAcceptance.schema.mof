[ClassVersion("1.0.0.0"), FriendlyName("AADTermsOfUseAcceptance")]
class MSFT_AADTermsOfUseAcceptance : OMI_BaseResource
{
    [Key, Description("The identifier of the agreement.")] String AgreementId;
    [Key, Description("The identifier of the user who accepted the agreement.")] String UserId;
    [Write, Description("The identifier of the agreement file accepted by the user.")] String AgreementFileId;
    [Write, Description("UPN of the user when the acceptance was recorded.")] String UserPrincipalName;
    [Write, Description("Display name of the user when the acceptance was recorded.")] String UserDisplayName;
    [Write, Description("Email of the user when the acceptance was recorded.")] String UserEmail;
    [Write, Description("The Timestamp when the acceptance was recorded.")] String RecordedDateTime;
    [Write, Description("The expiration date time of the acceptance.")] String ExpirationDateTime;
    [Write, Description("The current state of the acceptance."), ValueMap{"accepted","declined"}, Values{"accepted","declined"}] String State;
    [Write, Description("The unique identifier of the device used for accepting the agreement.")] String DeviceId;
    [Write, Description("The display name of the device used for accepting the agreement.")] String DeviceDisplayName;
    [Write, Description("The operating system used to accept the agreement.")] String DeviceOSType;
    [Write, Description("The operating system version of the device used to accept the agreement.")] String DeviceOSVersion;
    [Write, Description("Present ensures the acceptance exists, absent ensures it is removed."), ValueMap{"Present","Absent"}, Values{"Present","Absent"}] String Ensure;

    [Write, Description("Credentials of the workload's Admin"), EmbeddedInstance("MSFT_Credential")] string Credential;
    [Write, Description("Id of the Azure Active Directory application to authenticate with.")] String ApplicationId;
    [Write, Description("Secret of the Azure Active Directory application to authenticate with."), EmbeddedInstance("MSFT_Credential")] String ApplicationSecret;
    [Write, Description("Id of the Azure Active Directory tenant used for authentication.")] String TenantId;
    [Write, Description("Thumbprint of the Azure Active Directory application's authentication certificate to use for authentication.")] String CertificateThumbprint;
    [Write, Description("Managed ID being used for authentication.")] Boolean ManagedIdentity;
    [Write, Description("Access token used for authentication.")] String AccessTokens[];
};